WITH offers_count AS
    (
        SELECT
            AVG(salary_year_avg) AS avg_offer_salary
        FROM
            job_postings_fact
        WHERE
            job_title_short = 'Data Analyst'
    ),
skill_stats AS (
    SELECT
        skills_dim.skills,
        COUNT(job_postings_fact.job_id) AS skill_count,
        AVG(salary_year_avg) AS avg_skill_salary
    FROM
        skills_job_dim
    LEFT JOIN job_postings_fact ON skills_job_dim.job_id = job_postings_fact.job_id
    LEFT JOIN skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id
    WHERE
        job_postings_fact.job_title_short = 'Data Analyst'
    GROUP BY skills_dim.skills
)
SELECT 
    * 
FROM skill_stats
WHERE avg_skill_salary < (SELECT avg_offer_salary FROM offers_count) AND skill_count > 50
ORDER BY avg_skill_salary DESC;
